# Copy this file to .env and fill in your real values.
# Never commit .env -- it's already in .gitignore.

# SQLite file, relative to the repo root
DATABASE_URL=sqlite:///./data/table.db

APP_HOST=127.0.0.1
APP_PORT=8010

# Cloudflare Access (DESIGN.md §4, app/access.py). Leave ALL of these blank for local dev:
# every request is then Kev. On the droplet, ACCESS_TEAM_DOMAIN turns on verification of
# Access's signed token, and only the identities below get in. The app refuses to start
# if ACCESS_TEAM_DOMAIN is set without ACCESS_AUD and KEV_EMAILS, or if BETH_EMAILS is set
# without ACCESS_TEAM_DOMAIN.
#
# Your Zero Trust team domain, e.g. yourteam.cloudflareaccess.com (same as money-hub's)
ACCESS_TEAM_DOMAIN=
# The Table Access application's "Application Audience (AUD) Tag"
ACCESS_AUD=
# Sign-in emails, comma-separated. Both share the Table; each Plate is its owner's alone.
KEV_EMAILS=
BETH_EMAILS=
# The joint household Google account(s): the Table only, no Plate.
HOUSE_EMAILS=
# Client ID (not the secret) of the table-agent service token this project's cloud
# sessions use: reads the Table and Kev's Plate, writes only what app/access.py lists.
AGENT_SERVICE_TOKEN_ID=
# Client ID of the table-capture service token the "Send to Plate" Shortcut sends. It may
# only POST /api/capture, and the request also needs a person's capture token from
# Settings (DESIGN.md §9). Must differ from AGENT_SERVICE_TOKEN_ID.
CAPTURE_SERVICE_TOKEN_ID=

# Web Push (DESIGN.md §9). Make a pair once with `python scripts/make_vapid_keys.py`.
# Blank turns push off; everything else still works. The private key stays on the droplet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@syncyn.io

# Nightly encrypted backups to Cloudflare R2 (scripts/backup.sh). Only needed on the
# droplet. The R2 token should be scoped to the table-backups bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=table-backups
# age public key (age1...) backups are encrypted to. The private key stays OFF the droplet.
BACKUP_AGE_RECIPIENT=
