# The evening daily-session push (scripts/daily_reminder.py, DESIGN.md §9). Installed by
# hand once: see README.md "Phone".
[Unit]
Description=Table daily session reminder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=table
Group=table
WorkingDirectory=/opt/table
EnvironmentFile=/opt/table/.env
ExecStart=/opt/table/.venv/bin/python /opt/table/scripts/daily_reminder.py
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/table/data
