# Nightly encrypted backup to R2 (scripts/backup.sh, DESIGN.md §6). Installed by hand
# once: see README.md "Backups".
[Unit]
Description=Table encrypted database backup to R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=table
Group=table
EnvironmentFile=/opt/table/.env
ExecStart=/bin/bash /opt/table/scripts/backup.sh
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/table/data
